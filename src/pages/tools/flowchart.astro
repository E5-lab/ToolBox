---
import Base from '../../layouts/Base.astro';
---
<Base title="流程图绘制 - 我的工具箱" description="用 Mermaid 语法绘制流程图">
  <div class="tool-wrap">
    <a class="back" href="/">← 返回首页</a>
    <h1>📊 流程图绘制</h1>
    <p class="sub">用 Mermaid 语法写图，右侧实时渲染，可导出 SVG。本地渲染不上传。</p>

    <div class="btn-row">
      <button class="primary" id="btn-render">渲染</button>
      <button id="btn-svg">下载 SVG</button>
      <button id="btn-clear">清空</button>
    </div>
    <div class="msg" id="msg"></div>

    <div class="fc-grid">
      <textarea id="code" spellcheck="false">flowchart TD
    A[开始] --> B{是否登录?}
    B -- 是 --> C[进入首页]
    B -- 否 --> D[跳转登录]
    D --> C
    C --> E[结束]</textarea>
      <div class="fc-preview" id="preview"></div>
    </div>
  </div>
</Base>

<script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js" is:inline></script>

<script is:inline>
  const $ = (id) => document.getElementById(id);
  const code = $('code');
  const preview = $('preview');
  const msg = $('msg');
  function showMsg(t, type = 'error') { msg.textContent = t; msg.className = 'msg ' + type; }

  let mermaidReady = false;
  let seq = 0;
  function init() {
    if (!window.mermaid) return false;
    window.mermaid.initialize({ startOnLoad: false, securityLevel: 'loose', theme: 'default' });
    mermaidReady = true;
    return true;
  }

  async function render() {
    if (!mermaidReady) { if (!init()) return showMsg('流程图库加载中，请稍候重试'); }
    const src = code.value.trim();
    if (!src) return showMsg('请输入 Mermaid 代码');
    const id = 'm' + (++seq);
    try {
      const { svg } = await window.mermaid.render(id, src);
      preview.innerHTML = svg;
      showMsg('渲染成功', 'ok');
    } catch (e) {
      showMsg('渲染失败：' + (e && e.message ? e.message : '语法错误，请检查 Mermaid 语法'));
    }
  }

  $('btn-render').addEventListener('click', render);
  $('btn-clear').addEventListener('click', () => { code.value = ''; preview.innerHTML = ''; });
  $('btn-svg').addEventListener('click', () => {
    const svg = preview.querySelector('svg');
    if (!svg) return showMsg('请先渲染流程图');
    const data = new XMLSerializer().serializeToString(svg);
    const blob = new Blob([data], { type: 'image/svg+xml' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = 'flowchart.svg'; a.click();
    URL.revokeObjectURL(url);
  });

  if (init()) render();
  else { const t = setInterval(() => { if (init()) { render(); clearInterval(t); } }, 50); }
</script>

<style>
  .fc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 12px; }
  .fc-grid textarea { min-height: 420px; font-family: ui-monospace, Menlo, monospace; }
  .fc-preview {
    min-height: 420px; padding: 16px; overflow: auto;
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
  }
  .fc-preview svg { max-width: 100%; height: auto; }
  @media (max-width: 720px) { .fc-grid { grid-template-columns: 1fr; } }
</style>
