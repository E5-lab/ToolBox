---
import Base from '../../layouts/Base.astro';
---
<Base title="PDF 拆分 - 我的工具箱" description="按页码提取 PDF 页面">
  <div class="tool-wrap">
    <a class="back" href="/">← 返回首页</a>
    <h1>✂️ PDF 拆分 / 提取</h1>
    <p class="sub">上传一份 PDF，按页码范围提取页面。文件在浏览器本地处理，不上传。</p>

    <div class="field">
      <label for="file">选择 PDF 文件</label>
      <input type="file" id="file" accept="application/pdf" />
    </div>

    <div class="field">
      <label for="range">提取页码（例如：1-3,5,7-9；留空表示全部，基于 1 起始）</label>
      <input type="text" id="range" placeholder="1-3,5,7-9" />
    </div>

    <div class="btn-row">
      <button class="primary" id="btn-extract">提取为单份 PDF</button>
      <button id="btn-perpage" disabled>每页单独下载</button>
    </div>

    <div class="msg" id="msg"></div>
    <div class="file-list" id="info"></div>
  </div>
</Base>

<script src="https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js" is:inline></script>

<script is:inline>
  const $ = (id) => document.getElementById(id);
  const fileInput = $('file');
  const rangeInput = $('range');
  const msg = $('msg');
  const info = $('info');
  const btnPerPage = $('btn-perpage');
  let doc = null;        // loaded PDFDocument
  let pageBytes = [];    // per-page PDF bytes
  function showMsg(t, type = 'error') { msg.textContent = t; msg.className = 'msg ' + type; }
  function download(bytes, name) {
    const blob = new Blob([bytes], { type: 'application/pdf' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = name; a.click();
    URL.revokeObjectURL(url);
  }
  function parseRange(str, total) {
    const set = new Set();
    str.split(',').forEach((part) => {
      part = part.trim();
      if (!part) return;
      if (part.includes('-')) {
        let [a, b] = part.split('-').map((x) => parseInt(x, 10));
        if (isNaN(a)) a = 1; if (isNaN(b)) b = total;
        for (let i = a; i <= b; i++) if (i >= 1 && i <= total) set.add(i);
      } else {
        const n = parseInt(part, 10);
        if (!isNaN(n) && n >= 1 && n <= total) set.add(n);
      }
    });
    return [...set].sort((x, y) => x - y);
  }

  fileInput.addEventListener('change', async () => {
    const file = fileInput.files[0];
    if (!file) return;
    if (!window.PDFLib) return showMsg('PDF 库加载中，请稍候重试');
    try {
      const { PDFDocument } = window.PDFLib;
      const bytes = await file.arrayBuffer();
      doc = await PDFDocument.load(bytes);
      const total = doc.getPageCount();
      info.textContent = `已读取：${file.name}，共 ${total} 页`;
      btnPerPage.disabled = false;
      showMsg('读取成功', 'ok');
    } catch (e) { showMsg('读取失败：' + (e.message || e)); }
  });

  $('btn-extract').addEventListener('click', async () => {
    if (!doc) return showMsg('请先选择 PDF 文件');
    const total = doc.getPageCount();
    const pages = rangeInput.value.trim() ? parseRange(rangeInput.value, total) : doc.getPageIndices().map((i) => i + 1);
    if (pages.length === 0) return showMsg('没有匹配的页码');
    try {
      const { PDFDocument } = window.PDFLib;
      const out = await PDFDocument.create();
      for (const p of pages) {
        const [copied] = await out.copyPages(doc, [p - 1]);
        out.addPage(copied);
      }
      const bytes = await out.save();
      download(bytes, 'extracted.pdf');
      showMsg(`已提取 ${pages.length} 页`, 'ok');
    } catch (e) { showMsg('提取失败：' + (e.message || e)); }
  });

  btnPerPage.addEventListener('click', async () => {
    if (!doc) return;
    const total = doc.getPageCount();
    const { PDFDocument } = window.PDFLib;
    pageBytes = [];
    for (let i = 0; i < total; i++) {
      const out = await PDFDocument.create();
      const [copied] = await out.copyPages(doc, [i]);
      out.addPage(copied);
      pageBytes.push(await out.save());
    }
    // 顺序下载，间隔避免被浏览器拦截
    for (let i = 0; i < pageBytes.length; i++) {
      download(pageBytes[i], `page-${i + 1}.pdf`);
      await new Promise((r) => setTimeout(r, 300));
    }
    showMsg(`已生成 ${total} 个单页 PDF`, 'ok');
  });
</script>

<style>
  .file-list { margin-top: 12px; font-size: 13px; color: var(--muted); }
  input[type=file] { width: 100%; padding: 10px; border: 1px dashed var(--border); border-radius: 10px; background: var(--surface); color: var(--text); }
  button:disabled { opacity: .5; cursor: not-allowed; }
</style>
