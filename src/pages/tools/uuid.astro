---
import Base from '../../layouts/Base.astro';
---
<Base title="UUID 生成器 - 我的工具箱" description="批量生成 UUID v4">
  <div class="tool-wrap">
    <a class="back" href="/">← 返回首页</a>
    <h1>🆔 UUID 生成器</h1>
    <p class="sub">基于浏览器 crypto 生成 UUID v4，纯本地、随机、唯一。</p>

    <div class="field">
      <label for="count">生成数量</label>
      <div class="btn-row">
        <input type="number" id="count" value="5" min="1" max="500" style="max-width:140px" />
        <button class="primary" id="btn-gen">生成</button>
        <button id="btn-copy">复制全部</button>
        <button id="btn-clear">清空</button>
      </div>
    </div>

    <div class="msg" id="msg"></div>

    <div class="field">
      <label for="output">结果（每行一个）</label>
      <textarea id="output" readonly placeholder="点击「生成」后显示 UUID 列表"></textarea>
    </div>
  </div>
</Base>

<script is:inline>
  const $ = (id) => document.getElementById(id);
  const count = $('count');
  const output = $('output');
  const msg = $('msg');
  function showMsg(t, type = 'error') { msg.textContent = t; msg.className = 'msg ' + type; }

  function genOne() {
    if (crypto && crypto.randomUUID) return crypto.randomUUID();
    // 兜底实现
    const b = new Uint8Array(16);
    crypto.getRandomValues(b);
    b[6] = (b[6] & 0x0f) | 0x40;
    b[8] = (b[8] & 0x3f) | 0x80;
    const h = [...b].map((x) => x.toString(16).padStart(2, '0'));
    return `${h.slice(0,4).join('')}-${h.slice(4,6).join('')}-${h.slice(6,8).join('')}-${h.slice(8,10).join('')}-${h.slice(10).join('')}`;
  }

  $('btn-gen').addEventListener('click', () => {
    const n = Math.min(500, Math.max(1, parseInt(count.value || '1', 10) || 1));
    const list = [];
    for (let i = 0; i < n; i++) list.push(genOne());
    output.value = list.join('\n');
    showMsg(`已生成 ${n} 个 UUID`, 'ok');
  });

  $('btn-copy').addEventListener('click', async () => {
    if (!output.value) return;
    try { await navigator.clipboard.writeText(output.value); showMsg('已复制到剪贴板', 'ok'); }
    catch { showMsg('复制失败，请手动选择'); }
  });

  $('btn-clear').addEventListener('click', () => { output.value = ''; msg.className = 'msg'; });
</script>
