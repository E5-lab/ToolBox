---
import Base from '../../layouts/Base.astro';
---
<Base title="PDF 合并 - 我的工具箱" description="多份 PDF 合并为一份">
  <div class="tool-wrap">
    <a class="back" href="/">← 返回首页</a>
    <h1>🗂️ PDF 合并</h1>
    <p class="sub">选择多份 PDF，按选择顺序合并为一份。文件在浏览器本地处理，不上传。</p>

    <div class="field">
      <label for="files">选择 PDF 文件（可多选，按选择顺序合并）</label>
      <input type="file" id="files" accept="application/pdf" multiple />
    </div>

    <div class="btn-row">
      <button class="primary" id="btn-merge">合并</button>
      <button id="btn-download" disabled>下载合并结果</button>
      <button id="btn-clear">清空</button>
    </div>

    <div class="msg" id="msg"></div>
    <div class="file-list" id="file-list"></div>
  </div>
</Base>

<script src="https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js" is:inline></script>

<script is:inline>
  const $ = (id) => document.getElementById(id);
  const filesInput = $('files');
  const msg = $('msg');
  const fileList = $('file-list');
  const btnDownload = $('btn-download');
  let mergedBytes = null;
  function showMsg(t, type = 'error') { msg.textContent = t; msg.className = 'msg ' + type; }
  function download(bytes, name) {
    const blob = new Blob([bytes], { type: 'application/pdf' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = name; a.click();
    URL.revokeObjectURL(url);
  }

  filesInput.addEventListener('change', () => {
    const names = [...filesInput.files].map((f) => f.name);
    fileList.innerHTML = names.map((n, i) => `<div>${i + 1}. ${n}</div>`).join('');
    mergedBytes = null; btnDownload.disabled = true;
  });

  $('btn-merge').addEventListener('click', async () => {
    const files = [...filesInput.files];
    if (files.length < 2) return showMsg('请至少选择 2 份 PDF');
    if (!window.PDFLib) return showMsg('PDF 库加载中，请稍候重试');
    showMsg('合并中…', 'ok');
    try {
      const { PDFDocument } = window.PDFLib;
      const merged = await PDFDocument.create();
      for (const file of files) {
        const bytes = await file.arrayBuffer();
        const src = await PDFDocument.load(bytes);
        const pages = await merged.copyPages(src, src.getPageIndices());
        for (const p of pages) merged.addPage(p);
      }
      mergedBytes = await merged.save();
      btnDownload.disabled = false;
      showMsg(`合并完成，共 ${merged.getPageCount()} 页`, 'ok');
    } catch (e) {
      showMsg('合并失败：' + (e.message || e));
    }
  });

  btnDownload.addEventListener('click', () => {
    if (mergedBytes) download(mergedBytes, 'merged.pdf');
  });

  $('btn-clear').addEventListener('click', () => {
    filesInput.value = ''; fileList.innerHTML = ''; mergedBytes = null; btnDownload.disabled = true; msg.className = 'msg';
  });
</script>

<style>
  .file-list { margin-top: 12px; font-size: 13px; color: var(--muted); }
  .file-list div { padding: 3px 0; }
  input[type=file] { width: 100%; padding: 10px; border: 1px dashed var(--border); border-radius: 10px; background: var(--surface); color: var(--text); }
  button:disabled { opacity: .5; cursor: not-allowed; }
</style>
