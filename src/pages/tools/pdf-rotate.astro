---
import Base from '../../layouts/Base.astro';
---
<Base title="PDF 旋转 - 我的工具箱" description="按角度旋转 PDF 页面">
  <div class="tool-wrap">
    <a class="back" href="/">← 返回首页</a>
    <h1>🔄 PDF 旋转</h1>
    <p class="sub">按角度旋转全部或指定页。文件在浏览器本地处理，不上传。</p>

    <div class="field">
      <label for="file">选择 PDF 文件</label>
      <input type="file" id="file" accept="application/pdf" />
    </div>

    <div class="field">
      <label for="angle">旋转角度</label>
      <select id="angle">
        <option value="90">顺时针 90°</option>
        <option value="180">180°</option>
        <option value="270">顺时针 270°（即逆时针 90°）</option>
      </select>
    </div>

    <div class="field">
      <label for="range">旋转指定页（例如 1,3-5；留空=全部，基于 1 起始）</label>
      <input type="text" id="range" placeholder="1,3-5" />
    </div>

    <div class="btn-row">
      <button class="primary" id="btn-rotate">旋转并下载</button>
    </div>

    <div class="msg" id="msg"></div>
    <div class="file-list" id="info"></div>
  </div>
</Base>

<script src="https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js" is:inline></script>

<script is:inline>
  const $ = (id) => document.getElementById(id);
  const fileInput = $('file');
  const angleSel = $('angle');
  const rangeInput = $('range');
  const msg = $('msg');
  const info = $('info');
  function showMsg(t, type = 'error') { msg.textContent = t; msg.className = 'msg ' + type; }
  function download(bytes, name) {
    const blob = new Blob([bytes], { type: 'application/pdf' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = name; a.click();
    URL.revokeObjectURL(url);
  }
  function parseRange(str, total) {
    const set = new Set();
    str.split(',').forEach((part) => {
      part = part.trim();
      if (!part) return;
      if (part.includes('-')) {
        let [a, b] = part.split('-').map((x) => parseInt(x, 10));
        if (isNaN(a)) a = 1; if (isNaN(b)) b = total;
        for (let i = a; i <= b; i++) if (i >= 1 && i <= total) set.add(i);
      } else {
        const n = parseInt(part, 10);
        if (!isNaN(n) && n >= 1 && n <= total) set.add(n);
      }
    });
    return [...set].sort((x, y) => x - y);
  }

  $('btn-rotate').addEventListener('click', async () => {
    const file = fileInput.files[0];
    if (!file) return showMsg('请先选择 PDF 文件');
    if (!window.PDFLib) return showMsg('PDF 库加载中，请稍候重试');
    try {
      const { PDFDocument } = window.PDFLib;
      const bytes = await file.arrayBuffer();
      const doc = await PDFDocument.load(bytes);
      const total = doc.getPageCount();
      const angle = parseInt(angleSel.value, 10);
      const targets = rangeInput.value.trim() ? parseRange(rangeInput.value, total) : doc.getPageIndices().map((i) => i + 1);
      const pages = doc.getPages();
      for (const p of targets) {
        const page = pages[p - 1];
        page.setRotation(page.getRotation().angle + angle);
      }
      const out = await doc.save();
      download(out, 'rotated.pdf');
      info.textContent = `已旋转 ${targets.length} 页（共 ${total} 页）`;
      showMsg('旋转完成，已开始下载', 'ok');
    } catch (e) { showMsg('旋转失败：' + (e.message || e)); }
  });
</script>

<style>
  .file-list { margin-top: 12px; font-size: 13px; color: var(--muted); }
  input[type=file] { width: 100%; padding: 10px; border: 1px dashed var(--border); border-radius: 10px; background: var(--surface); color: var(--text); }
</style>
